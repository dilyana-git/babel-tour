# The video archive. The tour no longer plays any of it — the clips are gone
# from the piece, nothing in src/ names a .mp4, and the build drops anything
# matching video* on the way out (see vite.config.js). What is left here is
# ~2.4 GB of source renders and super-resolution experiments, kept because
# several clips survive nowhere else, and never tracked: a `git add -A` would
# otherwise commit the lot.
/public/video/
/public/video-2x/
/public/video-fit/
/public/video-fit-1888/
/public/video-latest/
/public/video-latest2/
/public/video-plain/
/public/video-x4/
/public/video-x4-48/
/public/video-x4-full/
/public/overture.mp4
/public/clip.mp4

# Raw art out of the generation pipeline: the full-size MJ candidates and their
# working files. What the tour actually serves is the WebP derived from them and
# committed under public/nodes/.
source-assets/
